{
  "expo": {
    "name": "Kormic Careers",
    "slug": "kormic-careers-candidate",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kormiccareers",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12132A",
    "splash": {
      "backgroundColor": "#12132A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.kormic.careers"
    },
    "android": {
      "package": "ai.kormic.careers",
      "adaptiveIcon": {
        "backgroundColor": "#12132A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "expo-document-picker"
    ],
    "extra": {
      "apiHost": "https://api.kormic.ai",
      "corridorKey": "sample",
      "useMocks": true
    }
  }
}
